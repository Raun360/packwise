# Copy this file to .env.local and fill in your real value.
# .env.local is gitignored — .env.example is the committed template.

# Google Analytics 4 Measurement ID (Admin → Data Streams → your web stream).
# Looks like G-XXXXXXXXXX. Leave blank to run with analytics fully disabled —
# the app works identically either way, it just won't send events.
VITE_GA_MEASUREMENT_ID=

# Unsplash API Access Key (unsplash.com/developers → Your apps → New Application).
# Used to fetch a representative photo per destination. Leave blank to run with
# a plain gradient fallback everywhere instead of photos.
VITE_UNSPLASH_ACCESS_KEY=
